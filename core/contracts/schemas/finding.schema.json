{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alltools-cybersec.local/contracts/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "required": ["id", "assessmentId", "assetId", "title", "status", "severity", "confidence", "createdAt"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "assessmentId": { "type": "string", "minLength": 1 },
    "assetId": { "type": "string", "minLength": 1 },
    "ruleId": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": { "type": "string", "enum": ["DETECTED", "NEEDS_REVIEW", "CONFIRMED", "FALSE_POSITIVE", "ACCEPTED_RISK", "MITIGATED", "REMEDIATION", "RETEST_REQUIRED", "RESOLVED", "REGRESSION"] },
    "severity": { "type": "string", "enum": ["informational", "low", "medium", "high", "critical"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "cwe": { "type": "string" },
    "cve": { "type": "string" },
    "cvss": { "type": "number", "minimum": 0, "maximum": 10 },
    "impact": { "type": "string" },
    "recommendation": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
